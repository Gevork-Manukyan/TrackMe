# Copy this file to `.env.local` and fill in values from your Supabase project.

# --- Site ---
# Canonical production URL, used for metadataBase, canonical links, OG/Twitter
# image URLs, robots.txt, and the sitemap. Falls back to the production domain in
# code if unset, so this is mainly for preview deploys pointing at their own URL.
NEXT_PUBLIC_SITE_URL="https://trackme.gevorkmanukyan.com"

# --- Supabase Auth (browser-safe, exposed to the client) ---
# Supabase dashboard → Connect → App Frameworks (or Project Settings → API keys).
# Use the PUBLISHABLE key (sb_publishable_...). Never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxx"

# --- Prisma / Postgres ---
# Supabase dashboard → Connect → ORMs. Replace [PASSWORD] with your database
# password and copy the exact host (region) shown there.

# Pooled connection (Transaction mode, port 6543) — runtime queries on serverless.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (Session mode, port 5432) — used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"
