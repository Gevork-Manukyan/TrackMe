// TrackMe — Prisma schema
// Data layer for the server side only. The client never imports Prisma;
// it talks to Dexie (IndexedDB) locally and to server actions over the network.
//
// Auth users are owned by Supabase (auth.users). We keep a mirror `User` row in
// the public schema, keyed by the Supabase auth uid, so our data can foreign-key
// to it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (PgBouncer, port 6543) — used at runtime on Vercel serverless.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — used by `prisma migrate` / introspection.
  directUrl = env("DIRECT_URL")
}

model User {
  id         String     @id // = Supabase auth uid (uuid as string)
  email      String?
  createdAt  DateTime   @default(now())
  categories Category[]
  items      Item[]
}

model Category {
  id        String   @id @default(uuid()) // client-generated so offline creates get a stable id
  userId    String
  name      String
  createdAt DateTime @default(now())
  deletedAt DateTime? // soft delete so deletions sync offline

  // Two timestamps with different jobs. `updatedAt` is authored by the client and
  // decides last-write-wins; it must NOT be @updatedAt, or the server clock would
  // overwrite an offline edit's real time and let a stale edit win.
  updatedAt       DateTime
  // Authored by the server on every write. Drives the pull cursor, so a device
  // with a skewed clock can never skip records.
  serverUpdatedAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items Item[]

  @@index([userId])
  @@index([userId, serverUpdatedAt])
}

model Item {
  id         String    @id @default(uuid()) // client-generated for offline creates
  categoryId String
  userId     String // denormalized for direct ownership checks
  name       String
  visited    Boolean   @default(false)
  visitedAt  DateTime?

  // Optional data points
  notes   String?
  address String? // free-text location (e.g. "123 Main St" or "Downtown")
  rating  Int?
  url     String?

  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft delete so deletions sync offline

  // See Category above: client-authored for LWW, server-authored for the cursor.
  updatedAt       DateTime
  serverUpdatedAt DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
  @@index([userId, serverUpdatedAt])
}
